# Git ignore patterns

# Environment variables
.env
.env.local
.env.*.local
*.pem

# Configuration
config.yaml
!config.example.yaml

# Logs
logs/
*.log
logger-*.log

# Session files (if persisted)
sessions/
*.session

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
PIPFILE.lock

# Virtual environments
venv/
ENV/
env/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# Database
*.db
*.sqlite
*.sqlite3

# Cache
.cache/
*.cache

# OS
Thumbs.db
.DS_Store

# Project specific
.mypy_cache/
.dmypy.json
dmypy.json

# Temporary
*.tmp
*.bak
*.swp
*~

# Secrets (if accidentally committed)
secrets/
*.key
*.pem
*.p12

# IDE generated files
*.iml
*.iws
*.ipr

# Testing artifacts
test_session/
test_logs/
